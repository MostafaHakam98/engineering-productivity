{
  "permissions": {
    "allow": [
      "Bash(pwd)",
      "Bash(ls*)",
      "Bash(tree*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git branch*)",
      "Bash(find . -maxdepth 3*)",
      "Bash(grep*)",
      "Bash(rg*)",
      "Bash(cmake --preset*)",
      "Bash(cmake --build*)",
      "Bash(pytest*)",
      "Bash(python -m pytest*)",
      "Bash(pylint*)",
      "Bash(ruff*)",
      "Bash(mypy*)",
      "Bash(safe-git status*)",
      "Bash(safe-git diff*)",
      "Bash(safe-git log*)",
      "Bash(safe-git branch*)",
      "Bash(safe-git checkout*)",
      "Bash(safe-git add*)",
      "Bash(safe-git commit*)",
      "Bash(safe-git push*)",
      "Bash(safe-glab mr*)",
      "Bash(safe-glab issue*)",
      "Bash(safe-glab label list*)",
      "Bash(safe-glab pipeline*)",
      "Bash(safe-glab repo*)"
    ],
    "deny": [
      "Bash(rm -rf*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -fd*)",
      "Bash(git push --force*)",
      "Bash(sudo rm*)",
      "Bash(chmod -R 777*)",
      "Bash(chown -R*)"
    ]
  }
}

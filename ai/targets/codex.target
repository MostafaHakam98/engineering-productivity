# OpenAI Codex CLI — https://github.com/openai/codex
TARGET_LABEL="Codex CLI"
TARGET_HOME="${CODEX_HOME:-$HOME/.codex}"

INSTRUCTIONS_DEST="$TARGET_HOME/AGENTS.md"
INSTRUCTIONS_TITLE="Global Codex Preferences"

SKILLS_DEST="$TARGET_HOME/skills"
SKILLS_FORMAT="skill-dir"

COMMANDS_DEST="$TARGET_HOME/prompts"
COMMANDS_FORMAT="md"

AGENTS_DEST="$TARGET_HOME/agents"
AGENTS_FORMAT="toml"

# Codex expresses sandboxing in config.toml, not as an allow/deny rule list.
PERMISSIONS_DEST=""
PERMISSIONS_FORMAT=""

PROJECT_DEST=".codex"
PROJECT_FORMAT="agents-md"

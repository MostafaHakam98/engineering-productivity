#!/usr/bin/env bash
# Lightweight heuristics. Ordinary print calls and task comments are advisory.
set -euo pipefail
diff="$(git diff --cached --no-ext-diff --no-textconv --unified=0 --diff-filter=ACM)"
if grep -qE '^\+[[:space:]]*-----BEGIN (RSA |OPENSSH |EC |DSA )?PRIVATE KEY-----[[:space:]]*$|^\+.*AKIA[0-9A-Z]{16}' <<< "$diff"; then
    echo "[pre-commit] blocked: possible private key or AWS access key in staged additions." >&2
    echo "Remove the credential and rotate it if exposed. No staged content is printed." >&2
    exit 1
fi
if grep -qE '^\+.*\b(TODO|FIXME)\b' <<< "$diff"; then
    echo "[pre-commit] task markers found; consider tracking them in an issue." >&2
    if [ "${ENGPROD_STRICT_HOOKS:-0}" = 1 ]; then
        echo "Strict mode blocks task markers (ENGPROD_STRICT_HOOKS=1)." >&2
        exit 1
    fi
fi
echo "[pre-commit] passed (heuristics do not replace a secret scanner)."

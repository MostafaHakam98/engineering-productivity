#!/usr/bin/env bash
# Read-only syntax check. Never execute project code or write bytecode/databases.
set -euo pipefail
if [ -z "$(git ls-files '*.py')" ]; then
    echo "[pre-push] no tracked Python files; skipped."
    exit 0
fi
command -v python3 >/dev/null || {
    echo "[pre-push] python3 unavailable; syntax check skipped." >&2; exit 0;
}
git ls-files -z '*.py' | python3 -c '
import ast, pathlib, sys
failed = False
for name in sys.stdin.buffer.read().split(b"\0"):
    if not name:
        continue
    path = pathlib.Path(name.decode("utf-8", "surrogateescape"))
    if not path.is_file() or path.is_symlink():
        continue
    try:
        # compile() honors Python encoding cookies without executing the code.
        compile(path.read_bytes(), str(path), "exec", ast.PyCF_ONLY_AST)
    except (SyntaxError, ValueError) as error:
        print(f"{path}: {error}", file=sys.stderr)
        failed = True
sys.exit(int(failed))
'
echo "[pre-push] Python syntax passed."

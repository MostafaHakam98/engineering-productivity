#!/usr/bin/env bash
# forge — Engineering Productivity CLI
set -euo pipefail

REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
VERSION="$(cat "$REPO_DIR/VERSION")"
if (( BASH_VERSINFO[0] < 4 )); then
    echo "forge requires Bash 4 or newer." >&2; exit 1
fi

# ─── colors ──────────────────────────────────────────────────────────────────
B='\033[0;34m'   G='\033[0;32m'   Y='\033[1;33m'   R='\033[0;31m'
C='\033[0;36m'   W='\033[1;37m'   D='\033[2m'       NC='\033[0m'

# ─── primitives ──────────────────────────────────────────────────────────────
ok()    { echo -e "  ${G}✓${NC}  $*"; }
warn()  { echo -e "  ${Y}!${NC}  $*"; }
fail()  { echo -e "  ${R}✗${NC}  $*"; }
info()  { echo -e "  ${D}·${NC}  $*"; }
step()  { echo -e "\n  ${C}▸${NC}  $*"; }
blank() { echo ""; }
sep()   { echo -e "  ${D}$(printf '─%.0s' {1..54})${NC}"; }

_pause() { blank; printf "  Press Enter to continue..."; read -r _; }

_confirm() {
    blank
    printf "  %b%s%b  [y/N]  " "$Y" "${1:-Continue?}" "$NC"
    read -r _ans || return 1
    [[ "$_ans" =~ ^[Yy]$ ]]
}

_banner() {
    blank
    echo -e "  ${B}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo -e "    ${W}forge${NC}  ${D}—${NC}  Engineering Productivity  ${D}v${VERSION}${NC}"
    echo -e "    ${D}${REPO_DIR}${NC}"
    echo -e "  ${B}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
}

# ─── tty helpers ─────────────────────────────────────────────────────────────
_cursor_hide() { printf '\033[?25l'; }
_cursor_show() { printf '\033[?25h'; }

# ─── inline option picker ─────────────────────────────────────────────────────
# Usage: _pick "Option one" "Option two" ...
# Result in $_PICK_IDX (0-based index of selection)

_pick_draw() {
    local sel="$1"; shift
    local i=0
    for opt in "$@"; do
        if [[ "$i" -eq "$sel" ]]; then
            printf "\r  %b▶  %s%b\033[K\n" "$W" "$opt" "$NC"
        else
            printf "\r  %b   %s%b\033[K\n" "$D" "$opt" "$NC"
        fi
        i=$((i+1))
    done
    printf "\r  %b↑ ↓  navigate    Enter  select%b\033[K\n" "$D" "$NC"
}

_pick() {
    [[ -t 0 ]] || { fail "This installer requires a terminal. Use the module setup scripts for automation."; return 1; }
    local -a _opts=("$@")
    local _n="${#_opts[@]}" _idx=0
    _pick_draw "$_idx" "${_opts[@]}"
    _cursor_hide
    while true; do
        local _key; _key=$(_read_key) || { _cursor_show; return 1; }
        case "$_key" in
            $'\x1b[A'|k|K) _idx=$(( (_idx - 1 + _n) % _n )) ;;
            $'\x1b[B'|j|J) _idx=$(( (_idx + 1) % _n ))       ;;
            $'\n'|$'\r'|'') break ;;
        esac
        printf '\033[%dA' $(( _n + 1 ))
        _pick_draw "$_idx" "${_opts[@]}"
    done
    _cursor_show
    _PICK_IDX="$_idx"
}

_read_key() {
    local key seq
    IFS= read -r -s -n1 key 2>/dev/null || return 1
    if [[ "$key" == $'\x1b' ]]; then
        IFS= read -r -s -n2 -t0.1 seq 2>/dev/null || true
        key="${key}${seq}"
    fi
    printf '%s' "$key"
}

# ─── status checks ───────────────────────────────────────────────────────────
_s_shell() {
    if grep -qF 'source "$ENGPROD_DIR/shell/aliases/loader.sh"' "$HOME/.bashrc" 2>/dev/null; then
        echo ok; return
    fi
    if ls "$HOME/.bashrc.d"/[0-9][0-9]-*.sh &>/dev/null 2>&1; then
        local installed total
        installed=$(ls "$HOME/.bashrc.d"/[0-9][0-9]-*.sh 2>/dev/null | wc -l | tr -d ' ')
        total=$(grep -c '^[^#[:space:]]' "$REPO_DIR/shell/aliases/load-order.conf" 2>/dev/null || echo 0)
        [[ "$total" -gt 0 && "$installed" -ge "$total" ]] && echo "ok" || echo "warn"
    else
        echo "none"
    fi
}

_s_hooks() {
    local hpath
    hpath=$(git config --global core.hooksPath 2>/dev/null || true)
    [[ -n "$hpath" && -f "$hpath/pre-commit" ]] && echo "ok" || echo "none"
}

_s_browser() {
    local n=0
    for f in ActiTime-AutoFill GitLab-File-Tree GitLab-Issue-MR; do
        [[ -f "$REPO_DIR/browser/scripts/${f}.js" ]] && n=$((n + 1))
    done
    if   [[ "$n" -eq 3 ]]; then echo "ok"
    elif [[ "$n" -gt 0 ]]; then echo "warn"
    else echo "none"; fi
}

# AI config is installed per target; report across all declared targets.
_ai_targets() {
    local t
    for t in "$REPO_DIR"/ai/targets/*.target; do
        [[ -f "$t" ]] && basename "$t" .target
    done
}

# _ai_target_installed <target> -> 0 if this kit installed into it
_ai_target_installed() {
    local home
    home=$(bash -c '. "$1"; printf %s "$TARGET_HOME"' _ "$REPO_DIR/ai/targets/$1.target")
    [[ -f "$home/.engineering-productivity.manifest" ]]
}

_s_ai() {
    local n=0 total=0 t
    while read -r t; do
        [[ -n "$t" ]] || continue
        total=$((total + 1))
        _ai_target_installed "$t" && n=$((n + 1))
    done < <(_ai_targets)
    if   [[ "$n" -eq 0 ]];      then echo "none"
    elif [[ "$n" -eq "$total" ]]; then echo "ok"
    else echo "warn"; fi
}

_s_ext() {
    local n=0 total=0 d id
    for d in "$REPO_DIR"/extensions/*/; do
        [[ -f "$d/extension.json" ]] || continue
        total=$((total + 1))
        id=$(python3 -c 'import json,sys;print(json.load(open(sys.argv[1]))["extensionId"])' "$d/extension.json" 2>/dev/null)
        [[ -n "$id" ]] && ls -d "$HOME/.vscode/extensions/${id,,}"-* &>/dev/null && n=$((n + 1))
    done
    if   [[ "$total" -eq 0 ]]; then echo "none"
    elif [[ "$n" -eq 0 ]];     then echo "none"
    elif [[ "$n" -eq "$total" ]]; then echo "ok"
    else echo "warn"; fi
}

_badge() {
    case "$1" in
        ok)   printf '%b✓  installed%b'  "$G" "$NC" ;;
        warn) printf '%b!  partial%b'    "$Y" "$NC" ;;
        none) printf '%b○  not set up%b' "$D" "$NC" ;;
    esac
}

# ─── module installers ───────────────────────────────────────────────────────

install_shell() {
    blank
    echo -e "  ${W}Shell Environment${NC}"
    sep
    blank
    echo -e "  Installs modular bash aliases and the starship prompt config."
    blank
    echo -e "  ${D}Installation method:${NC}"
    blank
    _pick \
        "copy     Copy files to ~/.bashrc.d/        — stable, re-run install to update" \
        "symlink  Symlink files to this repo        — auto-updates on git pull" \
        "direct   Source repo from ~/.bashrc        — instant changes, no file copying" || return
    blank
    local method
    case "$_PICK_IDX" in
        1) method="symlink" ;;
        2) method="direct"  ;;
        *) method="copy"    ;;
    esac
    blank
    if ! command -v starship &>/dev/null; then
        warn "starship not installed — prompt config will be skipped"
        info "Install after:  curl -sS https://starship.rs/install.sh | sh"
        blank
    fi

    step "Installing aliases  (method: ${method})"
    blank
    bash "$REPO_DIR/shell/aliases/al" install "$method" || return
    blank
    echo -e "  ${W}What's next:${NC}"
    info "source ~/.bashrc          apply changes in this terminal"
    info "al status                 verify load order and installed files"
    info "al doctor                 check for missing dependencies"
}

install_hooks() {
    blank
    echo -e "  ${W}Git Hooks${NC}"
    sep
    blank
    echo -e "  Installs ${G}pre-commit${NC} and ${G}pre-push${NC} hooks that check for:"
    blank
    info "Unresolved task markers left in committed code"
    info "Debug print statements (console.log, print, pdb, etc.)"
    info "Secrets and credentials accidentally staged"
    blank
    echo -e "  ${D}Where should hooks be installed?${NC}"
    blank
    _pick \
        "path     A specific repository you specify (recommended)" \
        "global   Apply to all git repositories on this machine" || return
    blank

    case "$_PICK_IDX" in
        0)
            printf "  Repository path: "
            read -r _repo_path || return 1
            blank
            if git -C "${_repo_path}" rev-parse --git-dir >/dev/null 2>&1; then
                step "Installing hooks in ${_repo_path}"
                bash "$REPO_DIR/git/hooks/setup.sh" "${_repo_path}" || return
            else
                fail "Not a git repository: ${_repo_path}"
                return 1
            fi
            ;;
        *)
            step "Installing hooks globally"
            blank
            bash "$REPO_DIR/git/hooks/install-global.sh" || return
            blank
            echo -e "  ${W}What's next:${NC}"
            info "Hooks will run automatically on every commit and push"
            info "hooks-install-global      re-sync hooks from repo at any time"
            info "To bypass (use sparingly):  git commit --no-verify"
            ;;
    esac
}

install_browser() {
    blank
    echo -e "  ${W}Browser Scripts${NC}"
    sep
    blank
    echo -e "  Configures TamperMonkey userscripts for:"
    blank
    info "GitLab   — enhanced file tree sidebar with keyboard navigation"
    info "GitLab   — issue-to-MR helper with branch auto-suggestions"
    info "ActiTIME — one-click time tracking automation"
    blank

    if [[ ! -f "$REPO_DIR/.env" ]]; then
        fail ".env file not found"
        blank
        echo -e "  ${W}Create it first:${NC}"
        info "cp $REPO_DIR/.env.example $REPO_DIR/.env"
        blank
        echo -e "  ${W}Required fields:${NC}"
        info "GITLAB_URL           your GitLab hostname (without https://)"
        info "COMPANY_NAME         used in script metadata"
        info "AUTHOR_NAME          your name for @author fields"
        info "STORAGE_KEY_PREFIX   short prefix for localStorage keys (2-3 chars)"
        blank
        return 1
    fi

    step "Configuring scripts from .env"
    blank
    bash "$REPO_DIR/browser/scripts/setup.sh" || return
    blank
    echo -e "  ${W}What's next:${NC}"
    info "Install Tampermonkey:  https://www.tampermonkey.net"
    info "Open each .js file in browser/scripts/ and install via Tampermonkey"
    info "To reconfigure:  run 'forge install browser' after editing .env"
}

install_ai() {
    blank
    echo -e "  ${W}AI Agent Config${NC}"
    sep
    blank
    echo -e "  One shared source in ${C}ai/shared/${NC} is rendered into every agent's"
    echo -e "  own dialect. Adding a new agent means adding one ${C}ai/targets/*.target${NC} file."
    blank
    echo -e "  ${D}You'll get, per target:${NC}"
    blank
    info "Instructions       global behavior, style, and token discipline rules"
    info "Skills             code-review  debug  plan-change  ci-fix  cmake-fix  checkpoint  vibe-audit  caveman  repo-profile"
    info "Commands           /review  /debug  /plan  /caveman  /ci-fix  /cmake-fix  /repo-profile"
    info "Agents             build-doctor  code-reviewer  test-planner  (where supported)"
    blank

    command -v python3 &>/dev/null || { fail "python3 is required"; return 1; }

    local -a targets=() labels=()
    local t label home
    while read -r t; do
        [[ -n "$t" ]] || continue
        label=$(sed -n 's/^TARGET_LABEL="\(.*\)"$/\1/p' "$REPO_DIR/ai/targets/$t.target")
        home=$(bash -c '. "$1"; printf %s "$TARGET_HOME"' _ "$REPO_DIR/ai/targets/$t.target")
        targets+=("$t"); labels+=("$label  ${D}($home)${NC}")
    done < <(_ai_targets)

    echo -e "  ${D}Which agent should receive the config?${NC}"
    blank
    _pick "All targets" "${labels[@]}" || return
    blank

    if [[ "$_PICK_IDX" -eq 0 ]]; then
        step "Installing into every target"
        blank
        bash "$REPO_DIR/ai/scripts/install-global.sh" all || return
    else
        t="${targets[$((_PICK_IDX - 1))]}"
        step "Installing into $t"
        blank
        bash "$REPO_DIR/ai/scripts/install-global.sh" "$t" || return
    fi

    blank
    if _confirm "Also install the declared third-party skills?"; then
        blank
        bash "$REPO_DIR/ai/scripts/install-external-skills.sh" || return
    fi

    blank
    echo -e "  ${W}What's next:${NC}"
    info "ai-install <target>       re-sync one agent from the kit"
    info "ai-port <target>          render to a temp dir to inspect before installing"
    info "ai-install-project <t>    bootstrap a project template in this directory"
    info "See ai/README.md for how to add a new agent as a target"
}

install_extensions() {
    blank
    echo -e "  ${W}Editor Extensions${NC}"
    sep
    blank
    echo -e "  Builds each extension declared in ${C}extensions/*/extension.json${NC}"
    echo -e "  from source and installs the ${C}.vsix${NC}, then installs its agent config."
    blank

    local d name desc
    for d in "$REPO_DIR"/extensions/*/; do
        [[ -f "$d/extension.json" ]] || continue
        name=$(basename "$d")
        desc=$(python3 -c 'import json,sys;print(json.load(open(sys.argv[1]))["displayName"])' "$d/extension.json")
        info "$(printf '%-12s %s' "$name" "$desc")"
    done
    blank

    if ! command -v git &>/dev/null; then
        fail "git is required but not installed"; return 1
    fi

    step "Building and installing"
    blank
    bash "$REPO_DIR/extensions/install.sh" || return
    blank
    info "Reload the editor window to activate."
}

# ─── install all ─────────────────────────────────────────────────────────────

_install_all() {
    _banner
    blank
    echo -e "  ${W}Install All Modules${NC}"
    sep
    blank
    echo -e "  This will set up your full engineering environment:"
    blank
    info "shell    bash aliases, starship prompt"
    info "hooks    git pre-commit & pre-push checks (globally)"
    info "browser  TamperMonkey scripts (requires .env)"
    info "ai       agent config for Claude, Codex, Cursor & Metwally"
    info "ext      editor extensions built from source"
    blank

    _confirm "Proceed with full installation?" || {
        blank; info "Cancelled. Run 'forge install <module>' to install individually."
        blank; return
    }

    local failed=0 module
    for module in shell hooks browser ai extensions; do
        if ! "install_$module"; then
            fail "$module installation failed"
            failed=$((failed + 1))
        fi
        blank; sep; blank
    done
    if (( failed > 0 )); then
        fail "$failed module(s) failed. Installation is incomplete."
        return 1
    fi

    blank
    echo -e "  ${B}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo -e "  ${G}  Installation complete.${NC}"
    echo -e "  ${B}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    blank
    echo -e "  ${W}Apply shell changes:${NC}"
    info "source ~/.bashrc              or open a new terminal"
    blank
    echo -e "  ${W}Verify everything:${NC}"
    info "forge status                  check all modules"
    info "forge doctor                  check dependencies"
    info "al doctor                     shell-specific checks"
    blank
}

# ─── status ──────────────────────────────────────────────────────────────────

cmd_status() {
    _banner
    blank
    echo -e "  ${W}Modules${NC}"
    sep
    blank

    local ss sh sb sc se
    ss=$(_s_shell); sh=$(_s_hooks); sb=$(_s_browser); sc=$(_s_ai); se=$(_s_ext)

    printf "  %b  %-9s%b  %b%-38s%b  %s\n" "$W" "shell"   "$NC" "$D" "Bash aliases, prompt & shell manager"       "$NC" "$(_badge "$ss")"
    printf "  %b  %-9s%b  %b%-38s%b  %s\n" "$W" "hooks"   "$NC" "$D" "Git pre-commit & pre-push quality checks"   "$NC" "$(_badge "$sh")"
    printf "  %b  %-9s%b  %b%-38s%b  %s\n" "$W" "browser" "$NC" "$D" "TamperMonkey scripts for GitLab & ActiTIME" "$NC" "$(_badge "$sb")"
    printf "  %b  %-9s%b  %b%-38s%b  %s\n" "$W" "ai"      "$NC" "$D" "Agent config across all AI targets"         "$NC" "$(_badge "$sc")"
    printf "  %b  %-9s%b  %b%-38s%b  %s\n" "$W" "ext"     "$NC" "$D" "Editor extensions built from source"        "$NC" "$(_badge "$se")"

    blank
    sep
    blank
    echo -e "  ${W}Environment${NC}"
    blank

    if command -v starship &>/dev/null; then
        ok "starship  $(starship --version 2>/dev/null | head -1)"
        [[ -f "$HOME/.config/starship.toml" ]] \
            && ok "starship config at ~/.config/starship.toml" \
            || warn "starship config missing  →  al starship install"
    else
        warn "starship not installed  →  curl -sS https://starship.rs/install.sh | sh"
    fi

    command -v atuin &>/dev/null \
        && ok "atuin  $(atuin --version 2>/dev/null | head -1)" \
        || info "atuin not installed (optional)"

    command -v fzf &>/dev/null \
        && ok "fzf  $(fzf --version 2>/dev/null | head -1)" \
        || info "fzf not installed (optional)"

    [[ -f "$HOME/.bash-preexec.sh" ]] \
        && ok "bash-preexec present" \
        || info "bash-preexec not found (optional — needed for atuin)"

    blank
    info "Run 'forge doctor' for a full dependency diagnostic."
    blank
}

# ─── doctor ──────────────────────────────────────────────────────────────────

cmd_doctor() {
    _banner
    blank
    echo -e "  ${W}Doctor — Dependency Check${NC}"
    sep
    blank
    local issues=0

    echo -e "  ${D}shell${NC}"; blank

    if grep -qF 'source "$ENGPROD_DIR/shell/aliases/loader.sh"' "$HOME/.bashrc" 2>/dev/null; then
        ok "Aliases installed with direct checkout sourcing"
    elif ls "$HOME/.bashrc.d"/[0-9][0-9]-*.sh &>/dev/null 2>&1; then
        local count total
        count=$(ls "$HOME/.bashrc.d"/[0-9][0-9]-*.sh 2>/dev/null | wc -l | tr -d ' ')
        total=$(grep -c '^[^#[:space:]]' "$REPO_DIR/shell/aliases/load-order.conf" 2>/dev/null || echo 0)
        [[ "$count" -ge "$total" && "$total" -gt 0 ]] \
            && ok "${count} alias files in ~/.bashrc.d/" \
            || { warn "${count}/${total} alias files  →  forge install shell"; issues=$((issues+1)); }
    else
        fail "Aliases not installed  →  forge install shell"; issues=$((issues+1))
    fi

    if command -v starship &>/dev/null; then
        ok "starship $(starship --version 2>/dev/null | head -1)"
        if [[ -f "$HOME/.config/starship.toml" ]]; then
            diff -q "$REPO_DIR/shell/starship/starship.toml" "$HOME/.config/starship.toml" &>/dev/null \
                && ok "starship config in sync" \
                || warn "starship config differs  →  al starship install"
        else
            fail "starship config not installed  →  al starship install"; issues=$((issues+1))
        fi
    else
        fail "starship not installed"
        info "Install:  curl -sS https://starship.rs/install.sh | sh"
        issues=$((issues+1))
    fi

    [[ -f "$HOME/.bash-preexec.sh" ]] \
        && ok "bash-preexec present" \
        || warn "bash-preexec not found (optional — needed for atuin)"

    command -v atuin &>/dev/null && ok "atuin $(atuin --version 2>/dev/null | head -1)" || info "atuin not installed (optional)"
    command -v fzf   &>/dev/null && ok "fzf $(fzf --version 2>/dev/null | head -1)"     || info "fzf not installed (optional)"
    command -v nvm   &>/dev/null && ok "nvm present"                                     || info "nvm not installed (optional)"

    blank; echo -e "  ${D}hooks${NC}"; blank

    local hpath; hpath=$(git config --global core.hooksPath 2>/dev/null || true)
    if [[ -n "$hpath" ]]; then
        ok "core.hooksPath = $hpath"
        [[ -f "$hpath/pre-commit" ]] && ok "pre-commit present" || { fail "pre-commit missing  →  forge install hooks"; issues=$((issues+1)); }
        [[ -f "$hpath/pre-push"   ]] && ok "pre-push present"   || { fail "pre-push missing  →  forge install hooks";   issues=$((issues+1)); }
    else
        warn "Hooks not installed globally  →  forge install hooks"; issues=$((issues+1))
    fi

    blank; echo -e "  ${D}browser${NC}"; blank

    [[ -f "$REPO_DIR/.env" ]] && ok ".env configured" || { warn ".env missing  →  cp .env.example .env"; issues=$((issues+1)); }
    for f in ActiTime-AutoFill GitLab-File-Tree GitLab-Issue-MR; do
        [[ -f "$REPO_DIR/browser/scripts/${f}.js" ]] \
            && ok "${f}.js configured" \
            || warn "${f}.js not generated  →  forge install browser"
    done

    blank; echo -e "  ${D}ai${NC}"; blank

    local t label home n_sk n_cm n_ag
    # Count manifest entries under a target's own destination prefix.
    # grep -c prints 0 and exits 1 when nothing matches, so the exit status is
    # swallowed rather than appending a second count.
    _mcount() { grep -c "^$2/" "$1" 2>/dev/null || true; }
    while read -r t; do
        [[ -n "$t" ]] || continue
        label=$(sed -n 's/^TARGET_LABEL="\(.*\)"$/\1/p' "$REPO_DIR/ai/targets/$t.target")
        home=$(bash -c '. "$1"; printf %s "$TARGET_HOME"' _ "$REPO_DIR/ai/targets/$t.target")
        if _ai_target_installed "$t"; then
            # Destinations differ per target (Cursor keeps skills in rules/),
            # so the prefixes come from the target file, not a fixed guess.
            local mf sk_d cm_d ag_d
            mf="$home/.engineering-productivity.manifest"
            eval "$(bash -c '. "$1"
                printf "sk_d=%q cm_d=%q ag_d=%q" \
                    "${SKILLS_DEST#"$TARGET_HOME"/}" \
                    "${COMMANDS_DEST#"$TARGET_HOME"/}" \
                    "${AGENTS_DEST#"$TARGET_HOME"/}"' _ "$REPO_DIR/ai/targets/$t.target")"
            # Cursor stores the instructions rule in the skills directory;
            # exclude it so the skill count means skills.
            local ins_d
            ins_d=$(bash -c '. "$1"
                printf %s "${INSTRUCTIONS_DEST#"$TARGET_HOME"/}"' _ "$REPO_DIR/ai/targets/$t.target")
            if [ -n "$sk_d" ]; then
                n_sk=$(awk -v p="$sk_d/" -v ins="$ins_d" 'index($0,p)==1 && $0!=ins {v=substr($0,length(p)+1); split(v,a,"/"); if(!seen[a[1]]++) n++} END {print n+0}' "$mf")
            else
                n_sk=0
            fi
            n_cm=$([ -n "$cm_d" ] && _mcount "$mf" "$cm_d" || echo 0)
            n_ag=$([ -n "$ag_d" ] && _mcount "$mf" "$ag_d" || echo 0)
            ok "$(printf '%-16s %s' "$label" "$home")"
            ok "$(printf '%-16s %s skills · %s commands · %s agents' "" "$n_sk" "$n_cm" "$n_ag")"
        else
            warn "$(printf '%-16s not installed  →  forge install ai' "$label")"
        fi
    done < <(_ai_targets)

    blank; echo -e "  ${D}extensions${NC}"; blank

    local d name id
    if ! ls "$REPO_DIR"/extensions/*/extension.json &>/dev/null; then
        info "none declared"
    else
        for d in "$REPO_DIR"/extensions/*/; do
            [[ -f "$d/extension.json" ]] || continue
            name=$(basename "$d")
            id=$(python3 -c 'import json,sys;print(json.load(open(sys.argv[1]))["extensionId"])' "$d/extension.json" 2>/dev/null)
            if ls -d "$HOME/.vscode/extensions/${id,,}"-* &>/dev/null; then
                ok "$(printf '%-16s installed (%s)' "$name" "$id")"
            else
                warn "$(printf '%-16s not installed  →  forge install ext' "$name")"
            fi
        done
    fi

    blank; sep; blank

    if [[ "$issues" -eq 0 ]]; then
        echo -e "  ${G}All checks passed.${NC}"
    else
        echo -e "  ${R}${issues} issue(s) found.${NC}  Run ${W}forge install${NC} to fix them."
    fi
    blank
    [[ "$issues" -eq 0 ]]
}

